# Proxy inverso con TLS automático (Let's Encrypt) para HaciendaGPT. Ejemplo (docs/despliegue.md).
# DOMINIO llega del entorno (docker-compose.yml); con «localhost» Caddy usa un certificado local.
#
# Caddy corre sin root y sin capacidades (Dockerfile.web, docker-compose.yml): puede abrir 80 y 443
# porque compose baja net.ipv4.ip_unprivileged_port_start a 80 dentro del contenedor.
{
	admin off
}

# Comprobación de salud del contenedor «web» (healthcheck de docker-compose.yml). Puerto interno, sin
# publicar y sin TLS: no depende del certificado ni de la API.
http://:8081 {
	respond /salud-web "ok" 200
}

{$DOMINIO:localhost} {
	encode zstd gzip

	# La API, bajo /api (el prefijo se quita: la API no lo conoce).
	handle_path /api/* {
		# La respuesta del agente llega en streaming (application/x-ndjson): sin búfer.
		reverse_proxy api:8000 {
			flush_interval -1
			# Caddy ya añade X-Forwarded-For/-Proto/-Host; uvicorn --proxy-headers los usa.
		}
		request_body {
			# Por encima de API_MAX_BODY_BYTES (32 MB por defecto): la API da su propio 413.
			max_size 40MB
		}
	}

	# Los ficheros con hash en el nombre: inmutables. Uno que no existe es un 404 (nunca index.html,
	# que el navegador guardaría un año como si fuera JavaScript).
	handle /assets/* {
		root * /srv/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# La interfaz: cualquier otra ruta, a index.html (aplicación de una página). Nada de aquí se guarda
	# sin revalidar: /, index.html, sw.js, el manifiesto y las rutas de la aplicación cambian con cada versión.
	handle {
		root * /srv/web
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# Un error (un /assets/… que no existe, por ejemplo) no se guarda en caché.
	handle_errors {
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Sin scripts ni estilos en línea (el tema se aplica desde /tema.js). data: para las capturas del
		# navegador, blob: para descargar la exportación de datos. frame-ancestors: nadie la enmarca.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}
}
