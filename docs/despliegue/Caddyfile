# Proxy inverso con TLS automático (Let's Encrypt) para HaciendaGPT. Ejemplo (docs/despliegue.md).
# DOMINIO llega del entorno (docker-compose.yml); con «localhost» Caddy usa un certificado local.
{$DOMINIO:localhost} {
	encode zstd gzip

	# La API, bajo /api (el prefijo se quita: la API no lo conoce).
	handle_path /api/* {
		# La respuesta del agente llega en streaming (application/x-ndjson): sin búfer.
		reverse_proxy api:8000 {
			flush_interval -1
			# Caddy ya añade X-Forwarded-For/-Proto/-Host; uvicorn --proxy-headers los usa.
		}
		request_body {
			# Por encima de API_MAX_BODY_BYTES (32 MB por defecto): la API da su propio 413.
			max_size 40MB
		}
	}

	# La interfaz: ficheros estáticos; cualquier otra ruta, a index.html (aplicación de una página).
	handle {
		root * /srv/web
		# El service worker y el manifiesto no se guardan en caché: cada versión nueva se instala.
		@sinCache path /sw.js /index.html /manifest.webmanifest
		header @sinCache Cache-Control "no-cache"
		@estaticos path /assets/*
		header @estaticos Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
