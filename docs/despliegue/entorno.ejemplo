# Variables de entorno de HaciendaGPT (plantilla). Copia a .env, rellena y protege: chmod 600 .env.
# docker-compose.yml exige que .env exista (env_file con required: true).
# La tabla completa, con valores por defecto y propósito, está en docs/despliegue.md.

DOMINIO=hacienda.example.org
AUTH_MODE=required

# Claves (secretos: nunca en el repositorio ni en los registros).
# HACIENDA_API_KEY: clave compartida que la API exige en la cabecera X-API-Key a TODA petición. La
# interfaz web no la envía: déjala vacía si el navegador habla con la API a través de Caddy (lo normal
# con AUTH_MODE=required, donde cada usuario entra con su cuenta). Rellénala solo si la API la usan
# clientes de máquina a máquina o si otro proxy delante de Caddy añade la cabecera.
HACIENDA_API_KEY=
HACIENDA_OPERATOR_KEY=
ANTHROPIC_API_KEY=
# Copias cifradas: python -m asistente.plataforma.cli.plataforma nueva-clave
PLATAFORMA_CLAVE_COPIAS=

# Correo (Gmail), si se ofrece el módulo.
CORREO_GOOGLE_CLIENT_ID=
CORREO_GOOGLE_CLIENT_SECRET=
CORREO_REDIRECT_URI=https://hacienda.example.org/api/correo/oauth/callback
CORREO_URL_RETORNO=/
CORREO_CLAVE_CIFRADO=

# Avisos fuera de la aplicación.
NOTIFY_WEBHOOK_URL=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_SUBJECT=

# Vigilancia externa de las tareas programadas (healthchecks.io o similar).
HEALTHCHECK_URL=

# Límite de peticiones por minuto y cliente (por proceso). 0 = sin límite: no lo dejes así en un
# servicio expuesto a Internet.
API_RATE_LIMIT_PER_MIN=60

# Memoria de conversaciones (Hindsight): en Docker hace falta un servidor de Hindsight aparte. Sin él, deja
# MEMORIA_CONVERSACIONES=false; con él, pon su dirección (http://host:puerto) en HINDSIGHT_URL y
# MEMORIA_CONVERSACIONES=true.
MEMORIA_CONVERSACIONES=false
HINDSIGHT_URL=

# Conectores MCP (docs/capacidades/conectores.md). Los secretos de cada servidor van aquí, en variables que el
# JSON nombra con env:NOMBRE; nunca en el JSON.
MCP_SERVIDORES=
MCP_DIR=./data/mcp

# Agente con navegador: misiones (docs/capacidades/navegador.md). Con NAVEGADOR_AGENTE=true el texto de las
# páginas visitadas sale hacia el proveedor del modelo.
NAVEGADOR_AGENTE=false
NAVEGADOR_CONFINAMIENTO=auto

# Plataforma.
MIGRACIONES_AUTOMATICAS=true
PLATAFORMA_TRABAJOS=
PLATAFORMA_TRABAJOS_DESACTIVADOS=
